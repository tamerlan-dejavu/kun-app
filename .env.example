# --- Образы (только staging/production) ---
# Откуда тянуть образы. IMAGE_TAG не задаём: его передаёт deploy.sh.
# REGISTRY=ghcr.io/tamerlan-dejavu/kun-app

# --- Django ---
# staging/production: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
# Домен сайта: на сервере его же используют ALLOWED_HOSTS и health-check (kun.kz / staging.kun.kz)
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost

# --- DB / Redis ---
POSTGRES_DB=kun
POSTGRES_USER=kun
POSTGRES_PASSWORD=kun
DATABASE_URL=postgis://kun:kun@db:5432/kun
# Порт БД на хосте в dev (DataGrip, psql): localhost:5433. Внутри Docker — db:5432
DB_HOST_PORT=5433
REDIS_URL=redis://redis:6379/0

# --- S3 (казахстанский провайдер) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMS-шлюз (console — код пишется в лог) ---
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER=KUN

# --- Почта (поддержка, служебные письма) ---
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@kun.kz

# --- 2ГИС ---
DGIS_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODERATORS_CHAT_ID=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kun.kz

# --- Наблюдаемость ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Web (Next.js) ---
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
API_INTERNAL_URL=http://api:8000
